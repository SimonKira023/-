# ============================================================
#  数码考古馆 · 大模型配置（复制为 .env 后填入你的 Key）
#  启动方式：双击 start.bat，或 python server/serve.py --port 8787
#  说明：.env 不进 git（见 .gitignore），Key 只在本机、只在服务端使用
# ============================================================

# ---------- 方式 A：DeepSeek 官方 API（最省事） ----------
# 1) 打开 https://platform.deepseek.com → 注册/登录
# 2) 左侧「API Keys」→ 创建 → 复制 sk- 开头的 Key
# 3) 粘贴到下面，保存本文件，重启服务
DEEPSEEK_API_KEY=sk-你的DeepSeekKey

# 可选：换模型或走兼容代理
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com


# ---------- 方式 B：火山方舟（豆包 / DeepSeek 等模型） ----------
# 1) 打开 https://console.volcengine.com/ark → 开通方舟
# 2) 创建「推理接入点」或直接用模型 ID，拿到 ep- 开头的接入点
# 3) 把 Key 和接入点填到下面（取消注释）
# ARK_CODING_API_KEY=你的火山方舟Key
# ARK_MODEL=ep-xxxxxxxx
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
